<resources>
    <!-- Same palette as the web console: warm paper, sage accent, Hanken Grotesk. -->
    <style name="Theme.MissionControl" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F8F3</item>
        <item name="android:statusBarColor">#F7F8F3</item>
        <item name="android:navigationBarColor">#F7F8F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">#18211B</item>
        <item name="android:textColorSecondary">#566159</item>
        <item name="android:textColorHint">#788177</item>
        <item name="android:colorAccent">#4E6A37</item>
        <item name="android:colorControlActivated">#4E6A37</item>
        <item name="android:colorButtonNormal">#4E6A37</item>
        <item name="android:fontFamily">@font/hanken_grotesk</item>
        <item name="android:buttonStyle">@style/Widget.Mission.Button</item>
    </style>
    <style name="Widget.Mission.Button" parent="android:Widget.Material.Button">
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
