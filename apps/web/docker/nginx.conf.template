server {
    listen ${NGINX_LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 2026-09-24: this used to reverse-proxy /v1/, /readyz, /healthz, and
    # /gateway/ to AGENT_BRAIN_API_URL/GATEWAY_API_URL — removed along with
    # both env vars (agent-harness/docs/components/gateway/web.md,
    # "Resolved: Shared agent-web + Identity-Routing Router"). The browser
    # now calls the shared router directly (a real public URL, CORS-enabled
    # on the router side) instead of same-origin through this proxy; this
    # container is a pure static-file server for the SPA bundle plus the
    # runtime-config.js the entrypoint renders (docker-entrypoint.sh,
    # runtime-config.js.template) telling that bundle where the router is.

    location / {
        try_files $uri $uri/ /index.html;
    }
}
