# Vite dev server — proxy target for /v1, /readyz, /healthz (either name works)
VITE_DEV_API_PROXY=http://localhost:8080
# AGENT_BRAIN_API_URL=http://localhost:8899

# Vite dev server — proxy target for /gateway/* (either name works). Points
# at workflows/cmd/gateway (docs/components/gateway/web.md), not agent-brain.
VITE_DEV_GATEWAY_PROXY=http://localhost:8090
# GATEWAY_API_URL=http://localhost:8090

# Finance always goes through the identity router, including local development.
# Optional build-time router base; runtime ROUTER_BASE_URL takes priority.
# VITE_ROUTER_BASE_URL=https://harness-router.example.com

# Preferred router mode: one forwarded router origin, matching production.
# Vite serves a runtime configuration that calls the router directly:
# /brain for Explorer, /gateway for chat, and top-level /connections/onboard.
# VITE_DEV_ROUTER_PROXY=http://localhost:3001

# Build-time: public path for static assets (use / for container/nginx, /explorer/ if behind that path)
VITE_BASE_PATH=/

# Build-time: absolute API origin (leave empty when nginx or Vite proxy serves API on same host)
# VITE_API_BASE_URL=https://agent-brain.example.com

# Build-time: absolute Gateway origin (leave empty — same-origin /gateway/
# via nginx or the Vite proxy above is the normal case; see Dockerfile's
# own comment on why there's no shared production default the way
# VITE_API_BASE_URL has one)
# VITE_GATEWAY_BASE_URL=https://gateway.example.com

# Optional Grafana deep links (Recall debug, Ops)
VITE_GRAFANA_BASE_URL=http://localhost:3000
# Use {trace_id} placeholder in trace URLs
# VITE_GRAFANA_TRACE_URL=http://localhost:3000/explore?trace={trace_id}

# Clerk — only value you typically override (production URLs are Dockerfile defaults).
VITE_CLERK_PUBLISHABLE_KEY=

# Onboarding page defaults (override if API /settings/onboarding unavailable)
VITE_MCP_SSE_URL=https://agent-memory.nighthawklabs.org/sse
VITE_PLUGINS_RAW_BASE=https://raw.githubusercontent.com/realnighthawk/agent-plugins/main
VITE_INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/realnighthawk/agent-plugins/main/plugins/cursor/install.sh
