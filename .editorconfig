root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,css,md,yml,yaml,html}]
indent_style = space
indent_size = 2

[*.swift]
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,webp,ttf,otf,mp4,wav,mp3}]
insert_final_newline = false
